# Placeholders only. Never put real keys in this file or commit a real .env.
#
# The server reads real environment variables (it does not load a .env file by itself):
#   - locally: set them in your shell before `python server.py`
#       PowerShell:   $env:AISSTREAM_API_KEY = "your key"
#       bash:         export AISSTREAM_API_KEY="your key"
#   - on Render: add them in the service's Environment tab (they stay on the server and never reach the browser)
# Each developer should use their own key locally, so a revoked key never breaks the deployed app.

# Live ships from aisstream.io (free key, optional; without it the Live ships button says it is off)
AISSTREAM_API_KEY=your-key-here

# GPT-assisted chat (optional; the built-in offline parser works without it)
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=

# Server
HOST=0.0.0.0
PORT=3001

# Speed on small hosts (see README)
TIDELINE_PLAN_CACHE_S=600
TIDELINE_PLAN_SLOTS=1
TIDELINE_PREWARM=1
